{
  "name": "agent-mail",
  "version": "0.1.0",
  "description": "Guardrailed email MCP server for AI agents",
  "type": "module",
  "bin": {
    "agent-mail": "./bin/agent-mail.mjs"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/index.ts serve",
    "reviewer": "tsx src/index.ts reviewer",
    "daemon": "tsx src/index.ts daemon",
    "install-daemon": "tsx src/index.ts install-daemon",
    "uninstall-daemon": "tsx src/index.ts uninstall-daemon",
    "status": "tsx src/index.ts status",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run audit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "imapflow": "^1.0.0",
    "inquirer": "^12.0.0",
    "js-yaml": "^4.1.0",
    "nodemailer": "^8.0.5",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
